APP_NAME=Production Task API
ENVIRONMENT=development
DATABASE_URL=postgresql+psycopg://task_api:task_api_local@localhost:5432/task_api
JWT_SECRET_KEY=replace-with-a-random-secret-at-least-32-bytes-long
JWT_ALGORITHM=HS256
JWT_ISSUER=production-task-api
JWT_AUDIENCE=production-task-api-clients
